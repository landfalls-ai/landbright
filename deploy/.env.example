# Landbright Docker settings. Every value here is also the built-in default in compose.infra.yml,
# so this file is optional: copy it to deploy/.env only to change something.
#
#   cp deploy/.env.example deploy/.env
#
# All credentials below are for local development and tests only. Never reuse them anywhere real.

# Interface the published ports bind to. 127.0.0.1 keeps everything off the LAN.
LANDBRIGHT_BIND_ADDR=127.0.0.1

# Postgres 16. Databases: landbright (app) and landbright_test (integration tests).
LANDBRIGHT_POSTGRES_PORT=57432
LANDBRIGHT_POSTGRES_USER=landbright
LANDBRIGHT_POSTGRES_PASSWORD=landbright-dev-only
LANDBRIGHT_POSTGRES_DB=landbright

# Valkey 8: sessions, rate limits, the sweeper's leader lock.
LANDBRIGHT_VALKEY_PORT=57379

# Mailpit: SMTP sink (accepts any user and password) and its web UI.
LANDBRIGHT_SMTP_PORT=57025
LANDBRIGHT_MAIL_UI_PORT=57825

# OpenBao in dev mode: signing keys and secrets. In memory; a restart forgets everything.
LANDBRIGHT_OPENBAO_PORT=57200
LANDBRIGHT_OPENBAO_TOKEN=landbright-dev-only
