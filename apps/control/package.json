{
  "name": "@landbright/control",
  "version": "0.1.0",
  "private": true,
  "description": "The control plane: the console API, directory, catalog, requests, grants, sync, webhooks and the sweeper.",
  "scripts": {
    "build": "nest build",
    "serve": "nest start --watch --preserveWatchOutput",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "LANDBRIGHT_INTEGRATION=infra vitest run test/health.integration.test.ts"
  },
  "dependencies": {
    "@landbright/contracts": "workspace:*",
    "@landbright/platform": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.8",
    "ioredis": "^5.11.1",
    "nestjs-zod": "^5.6.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/pg": "^8.15.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
