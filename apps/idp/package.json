    "test": "vitest run"
  },
  "dependencies": {
    "@landbright/contracts": "workspace:*",
    "@landbright/platform": "workspace:*",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "unplugin-swc": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
