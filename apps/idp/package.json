    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@simplewebauthn/server": "^14.1.0",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.11.1",
    "jose": "^6.2.17",
    "nodemailer": "^8.0.11",
    "oidc-provider": "^9.14.0",
    "otpauth": "^9.6.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/oidc-provider": "^9.13.1",
