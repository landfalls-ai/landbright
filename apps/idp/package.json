{
  "name": "@landbright/idp",
  "version": "0.1.0",
  "private": true,
  "description": "The protocol plane: OIDC / OAuth 2.1, sign-in pages, JWKS, token exchange. Small, hardened, no console code.",
  "scripts": {
    "build": "nest build",
    "serve": "nest start --watch --preserveWatchOutput",
    "start": "node --enable-source-maps dist/main.js",
