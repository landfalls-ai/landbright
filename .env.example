# Landbright app settings. Every value here is also the built-in default (libs/platform/src/config.ts), so this file
# is optional: copy it to .env only to change something. Every credential is for local development only.
#
#   cp .env.example .env

LANDBRIGHT_ENV=local

# Ports the three processes listen on (127.0.0.1 only).
LANDBRIGHT_CONSOLE_PORT=4400
LANDBRIGHT_CONTROL_PORT=4401
LANDBRIGHT_IDP_PORT=4402

# The identity plane's public URL; the issuer is <this>/oidc. And the console's, where sign-in comes back to.
LANDBRIGHT_IDP_URL=http://127.0.0.1:4402
LANDBRIGHT_CONSOLE_URL=http://127.0.0.1:4400

# The services connect as landbright_app, under row-level security. The owner (a superuser, which bypasses row-level
# security) runs migrations and the bootstrap only.
LANDBRIGHT_DATABASE_URL=postgres://landbright_app:landbright-app-dev-only@127.0.0.1:57432/landbright
LANDBRIGHT_DATABASE_ADMIN_URL=postgres://landbright:landbright-dev-only@127.0.0.1:57432/landbright

# The tenant this deployment serves.
LANDBRIGHT_TENANT_SLUG=local
LANDBRIGHT_TENANT_NAME=Local

# Seals signing keys and derives client secrets and cookie keys (32+ characters). Changing it invalidates every
# client secret and session and makes stored signing keys unreadable (new ones are generated).
LANDBRIGHT_SECRET_KEY=landbright-dev-only-secret-key-do-not-use-anywhere-real

# The first administrator, created by pnpm db:setup when missing.
LANDBRIGHT_BOOTSTRAP_ADMIN_EMAIL=admin@landbright.test
LANDBRIGHT_BOOTSTRAP_ADMIN_PASSWORD=landbright-dev-only

# Mail (Mailpit: the web UI at LANDBRIGHT_MAILPIT_URL shows what was sent).
LANDBRIGHT_SMTP_URL=smtp://127.0.0.1:57025
LANDBRIGHT_MAIL_FROM="Landbright <no-reply@landbright.test>"

# Infrastructure from deploy/compose.infra.yml.
LANDBRIGHT_VALKEY_URL=redis://127.0.0.1:57379
LANDBRIGHT_OPENBAO_ADDR=http://127.0.0.1:57200
LANDBRIGHT_OPENBAO_TOKEN=landbright-dev-only
LANDBRIGHT_MAILPIT_URL=http://127.0.0.1:57825

# OpenTelemetry. Tracing is off unless an exporter is set: an OTLP endpoint, or OTEL_TRACES_EXPORTER=console.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_TRACES_EXPORTER=console
